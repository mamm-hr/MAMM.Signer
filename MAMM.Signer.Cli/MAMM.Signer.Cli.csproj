<Project Sdk="Microsoft.NET.Sdk">

	<!-- Konfiguracija projekta. -->
	<PropertyGroup>
		<!-- Upisati ovdje verziju .NET-a za koju se gradi.-->
		<_MyNetCoreTarget Condition="'' == '$(_MyNetCoreTarget)'">net10.0</_MyNetCoreTarget>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>$(_MyNetCoreTarget)</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en</NeutralLanguage>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Izdvaja bazno ime projekta u svrhu formiranja imena ostalih projekata ovog rješenja. -->
		<_MyProjectBaseName Condition="'' == '$(_MyProjectBaseName)'">$([System.Text.RegularExpressions.Regex]::Match('$(MSBuildProjectName)', '^[^.]+(\.[^.]+)?').Value)</_MyProjectBaseName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\$(_MyProjectBaseName).Pkcs\$(_MyProjectBaseName).Pkcs.csproj" />
		<ProjectReference Include="..\$(_MyProjectBaseName).Core\$(_MyProjectBaseName).Core.csproj" />
	</ItemGroup>

	<Import Project="..\$(_MyProjectBaseName).Shared\$(_MyProjectBaseName).Certs.projitems" Label="Certs" />

	<!-- Priložene HelloWorld datoteke za testiranje se kopiraju u izlazni direktorij kod razvojne izgradnje, ali ne i
	kod publiciranja. Svojstvo _IsPublishing je definirano kad se izvršava dotnet publish. -->
	<ItemGroup>
		<Content Include="HelloWorld.*" Condition="'$(_IsPublishing)' == 'true'">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
		<Content Include="HelloWorld.*" Condition="'$(_IsPublishing)' != 'true'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources.Designer.cs">
			<DependentUpon>Resources.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources.resx">
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
			<Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>

</Project>
