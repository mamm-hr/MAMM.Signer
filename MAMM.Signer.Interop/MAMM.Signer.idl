		[id(6), helpstring("Ovjeri potpise PKCS #7/CMS \"signed-data content type\" (SignedData) poruke, opcionalno provjeri valjanost certifikata u lancu povjerenja potpisnih certifikata i vrati sadržaj potpisane poruke.")
		] HRESULT VerifySignedData(
			[in] VARIANT Data,
			[out, retval] VARIANT* pRetVal
		);

	};

