		helpstring("Objekt za izradu i èitanje potpisivanih i šifriranih podataka u PKCS #7, odn. CMS sintaksi (RFC 2315, odn. RFC 5652)."),
	] interface Pkcs7 : IDispatch {

		[id(1), propget, helpstring("Opcije za usmjeravanje rada metoda ove komponente.")
		] HRESULT Options([out, retval] Pkcs7Options** pRetVal);

