<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard20</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NeutralLanguage>en</NeutralLanguage>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Izdvaja bazno ime projekta u svrhu formiranja imena ostalih projekata ovog rješenja. -->
		<_MyProjectBaseName Condition="'' == '$(_MyProjectBaseName)'">$([System.Text.RegularExpressions.Regex]::Match('$(MSBuildProjectName)', '^[^.]+(\.[^.]+)?').Value)</_MyProjectBaseName>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\$(_MyProjectBaseName).Pkcs\$(_MyProjectBaseName).Pkcs.csproj" />
	</ItemGroup>

	<Import Project="..\$(_MyProjectBaseName).Shared\$(_MyProjectBaseName).CertsRef.projitems" Label="CertsRef" />

	<ItemGroup>
		<Compile Update="Resources.Designer.cs">
			<DependentUpon>Resources.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources.resx">
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
			<Generator>PublicResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>

</Project>
