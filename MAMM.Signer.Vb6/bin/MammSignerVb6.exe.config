<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
	Konfiguracija COM biblioteke potreba za .NET Framework aktivaciju, bez obzira koristi li se aktivacija sa ili
	bez registracije. Za .NET izgradnju biblioteke ova je datoteka nepotrebna.
-->
<configuration>
	<runtime>
		<!-- Konfiguracija glavnog sklopa COM biblioteke. Nije potrebna ako se koristi registracija, odnosno ako se DLL
		sklopa nalazi u istom direktoriju kao klijent ili u poddirektoriju koji se zove identično kao sklop (tj. u
		poddirektoriju ./MAMM.Signer.Interop). Potrebna ako se registracija ne koristi, a DLl se nalazi u poddirektoriju
		koji se zove drugačije od sklopa jer je u tom slučaju potrebno indicirati poddirektorij kroz element probing.
		-->
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="MAMM.Signer.Interop" culture="neutral" />
			</dependentAssembly>
			<!-- Popis poddirektorija razdvojenih s ";" u kojima se traži DLL kod aktivacije bez registracije. U ovaj
			poddirektorij staviti sve datoteke COM biblioteke. -->
  	  		<probing privatePath="lib\net48"/>
		</assemblyBinding>
		<!-- Konfiguracije drugih potrebnih sklopova. Konfiguracija sklopa nije potrebna kad se DLL sklopa nalazi u
		istom direktoriju kao klijent ili se koristi registracija, a DLL ima točno onu verziju s kojom je glavni sklop
		povezan. Konfiguracije je potrebna ako povezivanje treba preusmjeriti na točnu verziju DLL-a, bez obzira koristi
		li se registracija i potrebna je ako se DLL nalazi u bilo koojem poddirektoriju instalacijskog direktorija kad
		se aktivira bez registracije.
		-->
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Security.Cryptography.Pkcs" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-10.0.0.7" newVersion="10.0.0.7" />
			</dependentAssembly>
  	  		<probing privatePath="lib\net48"/>
		</assemblyBinding>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Security.Cryptography.Cng" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
			</dependentAssembly>
  	  		<probing privatePath="lib\net48"/>
		</assemblyBinding>
	</runtime>
</configuration>
